---
import Layout from './Layout.astro';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';

interface Props {
	label: string;
	title: string;
	subtitle: string;
}

const { label, title, subtitle } = Astro.props;
---

<Layout>
	<Header />

	<main class="pt-28 pb-20 max-w-[1200px] mx-auto px-6 relative">
		<!-- Decoraciones de fondo -->
		<div aria-hidden="true" class="absolute inset-0 -z-10 pointer-events-none before:content-[''] before:absolute before:inset-0 before:bg-[radial-gradient(ellipse_60%_50%_at_20%_15%,_theme(colors.teal.100/0.4)_0%,_transparent_70%),radial-gradient(ellipse_50%_40%_at_85%_25%,_theme(colors.stone.100/0.6)_0%,_transparent_60%)]"></div>
		<div aria-hidden="true" class="absolute -z-10 w-[500px] h-[500px] rounded-full blur-3xl opacity-10 pointer-events-none bg-teal-700 -top-24 -right-32 animate-pulse-glow-a"></div>
		<div aria-hidden="true" class="absolute -z-10 w-[320px] h-[320px] rounded-full blur-3xl opacity-10 pointer-events-none bg-amber-500 top-40 -left-24 animate-pulse-glow-b"></div>

		<div class="text-center mb-20 animate-fade-in-up">
			<div class="font-mono text-xs uppercase tracking-widest text-teal-700 mb-4">{label}</div>
			<h1 class="font-serif text-4xl md:text-6xl text-stone-900 mb-5 leading-tight">{title}</h1>
			<p class="text-lg text-stone-500 max-w-[600px] mx-auto">{subtitle}</p>
		</div>

		<div class="animate-fade-in-up animate-delay-100">
			<slot />
		</div>
	</main>

	<Footer />
</Layout>
