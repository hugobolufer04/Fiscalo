---
import ContentLayout from '../layouts/ContentLayout.astro';

const tipos = [
	{ tipo: 'Fijo', cuota: 'Estable durante todo el préstamo', interes: 'Más alto', riesgo: 'Nulo' },
	{ tipo: 'Variable', cuota: 'Revisable (suele ser anual)', interes: 'Más bajo', riesgo: 'Alto' },
	{ tipo: 'Mixto', cuota: 'Fija unos años, luego variable', interes: 'Intermedio', riesgo: 'Medio' },
];

const bloques = [
	{
		titulo: 'Fijo vs. variable',
		texto: 'Con un tipo fijo pagas más por la seguridad de una cuota constante. Con uno variable aprovechas tipos iniciales más bajos, pero asumes el riesgo de que suban. Tu decisión depende de cuánto valoras la estabilidad frente al ahorro inicial.',
		icon: 'M3 3v18h18',
	},
	{
		titulo: 'La TAE importa',
		texto: 'El tipo de interés no es el coste real: la TAE (Tasa Anual Equivalente) incluye comisiones y gastos. Compara siempre hipotecas por su TAE, no solo por su tipo nominal.',
		icon: 'M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3zM19 10v2a7 7 0 0 1-14 0v-2',
	},
	{
		titulo: 'Simula antes de firmar',
		texto: 'Antes de comprometerte, comprueba el impacto de distintos plazos y tipos en tu cuota y en el total de intereses que pagarás.',
		icon: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
	},
];
---

<ContentLayout
	label="Guía"
	title="Comparativa de Hipotecas"
	subtitle="Compara tipo fijo, variable y mixto para elegir la hipoteca que mejor se adapta a tu perfil."
>

	<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-3xl p-8 md:p-10 shadow-sm mb-12">
		<h2 class="font-serif text-2xl font-medium text-stone-900 mb-3">Los tres tipos de hipoteca</h2>
		<p class="text-sm text-stone-500 mb-10">Tu decisión entre fijo, variable y mixto depende de tu aversión al riesgo, tu horizonte temporal y tus previsiones sobre los tipos de interés.</p>
		<div class="overflow-x-auto rounded-2xl border border-stone-200">
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left bg-stone-50 border-b border-stone-200 text-xs uppercase tracking-wider text-stone-500">
						<th class="py-4 px-6">Tipo</th>
						<th class="py-4 px-6">Cuota</th>
						<th class="py-4 px-6">Interés inicial</th>
						<th class="py-4 px-6">Riesgo</th>
					</tr>
				</thead>
				<tbody>
					{tipos.map((t) => (
						<tr class="border-b border-stone-100 last:border-0 hover:bg-teal-50/40 transition-colors">
							<td class="py-3.5 px-6 font-medium text-stone-900">{t.tipo}</td>
							<td class="py-3.5 px-6 text-stone-600">{t.cuota}</td>
							<td class="py-3.5 px-6 text-stone-600">{t.interes}</td>
							<td class="py-3.5 px-6">
								<span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${t.riesgo === 'Nulo' ? 'bg-teal-50 text-teal-700' : t.riesgo === 'Medio' ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700'}`}>{t.riesgo}</span>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
		{bloques.map((b) => (
			<div class="group bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-teal-400">
				<div class="w-10 h-10 flex-shrink-0 rounded-xl bg-teal-50 group-hover:bg-teal-700 flex items-center justify-center mb-4 transition-colors duration-300">
					<svg class="w-5 h-5 text-teal-700 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={b.icon}/></svg>
				</div>
				<h2 class="font-serif text-lg font-medium text-stone-900 mb-2">{b.titulo}</h2>
				<p class="text-sm text-stone-500 leading-relaxed">{b.texto}</p>
			</div>
		))}
	</div>

	<div class="bg-teal-50 border border-teal-200 rounded-2xl p-7 flex items-start gap-4">
		<svg class="flex-shrink-0 text-teal-700 mt-0.5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
		<p class="text-sm text-teal-800 leading-relaxed"><strong>Simula:</strong> usa nuestra <a href="/calculadora/hipoteca" class="text-teal-700 underline hover:text-teal-800">calculadora de hipotecas</a> para comparar fijo, variable y mixto con tu capital y plazo.</p>
	</div>

</ContentLayout>
