---
import ContentLayout from '../layouts/ContentLayout.astro';

const tipos = [
	{
		titulo: 'Cookies técnicas',
		texto: 'Necesarias para el correcto funcionamiento del sitio. Sin ellas, la página no podría cargar ni funcionar como debería.',
		icon: 'M4 6h16M4 12h16M4 18h16',
	},
	{
		titulo: 'Cookies de preferencias',
		texto: 'Permiten recordar tus preferencias para mejorar tu experiencia de navegación en visitas sucesivas.',
		icon: 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z',
	},
];
---

<ContentLayout
	label="Legal"
	title="Política de Cookies"
	subtitle="Qué cookies utilizamos y cómo gestionarlas en tu navegador."
>

	<div class="grid grid-cols-1 gap-6 mb-10">
		<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm">
			<div class="flex items-center gap-4 mb-4">
				<div class="w-10 h-10 flex-shrink-0 rounded-xl bg-teal-50 flex items-center justify-center">
					<svg class="w-5 h-5 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><circle cx="8" cy="8" r="1.5" fill="currentColor"/><circle cx="15" cy="11" r="1.5" fill="currentColor"/><circle cx="11" cy="16" r="1.5" fill="currentColor"/></svg>
				</div>
				<div>
					<h2 class="font-serif text-xl font-medium text-stone-900">¿Qué son las cookies?</h2>
					<p class="text-sm text-stone-500">Pequeños archivos que se guardan en tu dispositivo para recordar preferencias y mejorar la navegación.</p>
				</div>
			</div>
			<p class="text-sm text-stone-600 leading-relaxed">En Fiscalo las calculadoras funcionan sin necesidad de cookies. Como mucho, este sitio utiliza las siguientes:</p>
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
		{tipos.map((t) => (
			<div class="group bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-teal-400">
				<div class="w-10 h-10 flex-shrink-0 rounded-xl bg-teal-50 group-hover:bg-teal-700 flex items-center justify-center mb-4 transition-colors duration-300">
					<svg class="w-5 h-5 text-teal-700 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon}/></svg>
				</div>
				<h2 class="font-serif text-xl font-medium text-stone-900 mb-3">{t.titulo}</h2>
				<p class="text-sm text-stone-500 leading-relaxed">{t.texto}</p>
			</div>
		))}
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
		<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-7 shadow-sm">
			<div class="w-10 h-10 flex-shrink-0 rounded-xl bg-teal-50 flex items-center justify-center mb-4">
				<svg class="w-5 h-5 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
			</div>
			<h2 class="font-serif text-xl font-medium text-stone-900 mb-2">¿Cómo desactivarlas?</h2>
			<p class="text-sm text-stone-500 leading-relaxed">Configura tu navegador (Chrome, Firefox, Safari, Edge…) desde sus ajustes de privacidad para bloquear o eliminar las cookies cuando quieras.</p>
		</div>
		<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-7 shadow-sm">
			<div class="w-10 h-10 flex-shrink-0 rounded-xl bg-teal-50 flex items-center justify-center mb-4">
				<svg class="w-5 h-5 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/></svg>
			</div>
			<h2 class="font-serif text-xl font-medium text-stone-900 mb-2">¿Dudas?</h2>
			<p class="text-sm text-stone-500 leading-relaxed">Si tienes preguntas sobre el uso de cookies, puedes contactar con nosotros a través de la página de <a href="/contacto" class="text-teal-700 font-medium hover:text-teal-800">contacto</a>.</p>
		</div>
	</div>

</ContentLayout>
