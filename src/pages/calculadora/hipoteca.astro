---
import Layout from '../../layouts/Layout.astro';
import Header from '../../sections/Header.astro';
import Footer from '../../sections/Footer.astro';
---

<Layout>
	<Header />

	<main class="pt-28 pb-20 max-w-[1200px] mx-auto px-6">
		<div class="text-center mb-12">
			<div class="font-mono text-xs uppercase tracking-widest text-teal-700 mb-3">Calculadora de Hipotecas</div>
			<h1 class="font-serif text-4xl md:text-5xl text-stone-900 mb-3">Cuánto vas a pagar realmente</h1>
			<p class="text-lg text-stone-500 max-w-[560px] mx-auto">Simula tu cuota mensual, el total de intereses y el cuadro de amortización con tipo fijo, variable o mixto.</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

			<!-- FORMULARIO -->
			<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm lg:sticky lg:top-24">
				<div class="mb-5">
					<label for="capital" class="block text-sm font-semibold text-stone-900 mb-1.5">Capital solicitado (€)</label>
					<input type="number" id="capital" min="0" step="5000" placeholder="180.000" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700" />
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
					<div>
						<label for="tipo" class="block text-sm font-semibold text-stone-900 mb-1.5">Tipo de interés anual (%)</label>
						<input type="number" id="tipo" min="0" max="20" step="0.05" placeholder="2,50" value="2.50" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700" />
						<div class="text-xs text-stone-500 mt-1" id="tipoHint">Tipo fijo</div>
					</div>
					<div>
						<label for="plazo" class="block text-sm font-semibold text-stone-900 mb-1.5">Plazo (años)</label>
						<select id="plazo" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700">
							<option value="10">10 años</option>
							<option value="15">15 años</option>
							<option value="20">20 años</option>
							<option value="25" selected>25 años</option>
							<option value="30">30 años</option>
							<option value="35">35 años</option>
						</select>
					</div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
					<div>
						<label for="tipoSelect" class="block text-sm font-semibold text-stone-900 mb-1.5">Tipo de hipoteca</label>
						<select id="tipoSelect" onchange="actualizarHint()" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700">
							<option value="fijo" selected>Fijo</option>
							<option value="variable">Variable</option>
							<option value="mixta">Mixta</option>
						</select>
					</div>
					<div>
						<label for="diferencial" class="block text-sm font-semibold text-stone-900 mb-1.5">Diferencial variable (%)</label>
						<input type="number" id="diferencial" min="0" max="5" step="0.05" placeholder="0,90" value="0.90" disabled class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-teal-700" />
						<div class="text-xs text-stone-500 mt-1">Solo para tipo variable/mixto</div>
					</div>
				</div>

				<button onclick="calcular()" class="w-full px-8 py-3.5 rounded-lg text-sm font-semibold text-white bg-teal-700 hover:bg-teal-800 transition-colors cursor-pointer">
					Calcular hipoteca
				</button>
			</div>

			<!-- RESULTADOS -->
			<div>
				<div id="placeholder" class="bg-white/70 backdrop-blur-md border border-dashed border-stone-300 rounded-2xl p-10 text-center text-stone-500">
					Introduce el capital, el tipo de interés y el plazo, y pulsa <strong class="text-teal-700">Calcular</strong>.
				</div>

				<div id="resultados" style="display:none">
					<!-- Tarjeta principal -->
					<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm mb-5">
						<div class="text-sm text-stone-500 mb-1">Tu cuota mensual</div>
						<div class="flex items-baseline gap-2">
							<span class="font-mono text-5xl font-semibold text-teal-700" id="cuotaMensual">—</span>
							<span class="text-stone-500 text-sm">€/mes</span>
						</div>
						<div class="text-sm text-stone-500 mt-1" id="cuotaTotal"></div>

						<div class="mt-6 border-t border-stone-200 pt-4 space-y-3">
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Capital solicitado</span>
								<span class="font-mono font-medium" id="rCapital">—</span>
							</div>
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Total intereses</span>
								<span class="font-mono font-medium text-amber-600" id="rIntereses">—</span>
							</div>
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Total a pagar</span>
								<span class="font-mono font-medium" id="rTotal">—</span>
							</div>
							<div class="flex justify-between text-sm border-t border-stone-200 pt-3">
								<span class="text-stone-900 font-semibold">Cuota 1er año</span>
								<span class="font-mono font-semibold text-teal-700" id="rCuota1">—</span>
							</div>
						</div>
					</div>

					<!-- Escenario variable / mixta -->
					<div id="variableSection" style="display:none" class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm mb-5">
						<h3 class="font-serif text-xl font-medium text-stone-900 mb-4">Escenario variable (Euribor + diferencial)</h3>
						<div class="space-y-3">
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Euribor actual (referencia)</span>
								<span class="font-mono font-medium" id="rEuribor">—</span>
							</div>
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Tipo aplicado</span>
								<span class="font-mono font-medium" id="rTipoVar">—</span>
							</div>
							<div class="flex justify-between text-sm border-t border-stone-200 pt-3">
								<span class="text-stone-900 font-semibold">Cuota mensual estimada</span>
								<span class="font-mono font-semibold text-teal-700" id="rCuotaVar">—</span>
							</div>
						</div>
					</div>

					<!-- Tabla de amortización -->
					<div id="amortCard" style="display:none" class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm">
						<h3 class="font-serif text-xl font-medium text-stone-900 mb-4">Primeros 12 meses</h3>
						<div class="overflow-x-auto">
							<table class="w-full text-sm">
								<thead>
									<tr class="text-left text-xs uppercase tracking-wider text-stone-500 border-b border-stone-200">
										<th class="py-2 pr-3">Mes</th>
										<th class="py-2 pr-3">Cuota</th>
										<th class="py-2 pr-3 text-teal-700">Capital</th>
										<th class="py-2 pr-3 text-amber-600">Intereses</th>
										<th class="py-2">Resta</th>
									</tr>
								</thead>
								<tbody id="amortBody"></tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

		</div>
	</main>

	<Footer />
</Layout>

<script>
	// Euribor de referencia (ajustar según datos actuales)
	const EURIBOR = 2.60;

	const fmt = (n: number) => String(n.toLocaleString('es-ES', { maximumFractionDigits: 0 }));

	const getInput = (id: string): HTMLInputElement | null =>
		document.getElementById(id) as HTMLInputElement | null;

	const getSelect = (id: string): HTMLSelectElement | null =>
		document.getElementById(id) as HTMLSelectElement | null;

	function setText(id: string, value: string): void {
		const el = document.getElementById(id);
		if (el) el.textContent = value;
	}

	function setDisplay(id: string, value: string): void {
		const el = document.getElementById(id);
		if (el) el.style.display = value;
	}

	function cuotaMensual(capital: number, tipoAnual: number, n: number): number {
		const i = tipoAnual / 100 / 12;
		return (capital * i * Math.pow(1 + i, n)) / (Math.pow(1 + i, n) - 1);
	}

	function actualizarHint(): void {
		const tipoSelect = getSelect('tipoSelect');
		const diferencial = getInput('diferencial');
		const tipo = getInput('tipo');
		if (!tipoSelect || !diferencial || !tipo) return;

		const valor = tipoSelect.value;
		if (valor === 'fijo') {
			diferencial.disabled = true;
			setText('tipoHint', 'Tipo fijo');
			tipo.placeholder = '2,50';
		} else if (valor === 'variable') {
			diferencial.disabled = false;
			setText('tipoHint', 'Euribor + diferencial');
			tipo.placeholder = EURIBOR.toFixed(2);
		} else {
			diferencial.disabled = false;
			setText('tipoHint', 'Fijo primeros años, luego variable');
			tipo.placeholder = '2,50';
		}
	}

	function calcular(): void {
		const capitalEl = getInput('capital');
		const tipoEl = getInput('tipo');
		const plazoEl = getSelect('plazo');
		const tipoSelectEl = getSelect('tipoSelect');
		const diferencialEl = getInput('diferencial');
		if (!capitalEl || !tipoEl || !plazoEl || !tipoSelectEl || !diferencialEl) return;

		const capital = parseFloat(capitalEl.value);
		if (!capital || capital <= 0) return;
		const tipoAnual = parseFloat(tipoEl.value);
		if (isNaN(tipoAnual) || tipoAnual <= 0) return;

		const plazo = parseInt(plazoEl.value, 10);
		const tipoSelect = tipoSelectEl.value;
		const diferencial = parseFloat(diferencialEl.value) || 0;

		const n = plazo * 12;
		const cuota = cuotaMensual(capital, tipoAnual, n);
		const totalPagado = cuota * n;
		const totalIntereses = totalPagado - capital;

		setDisplay('placeholder', 'none');
		setDisplay('resultados', '');
		setDisplay('amortCard', '');

		setText('cuotaMensual', fmt(Math.round(cuota)));
		setText('cuotaTotal', 'Total: ' + fmt(Math.round(totalPagado)) + ' €');
		setText('rCapital', fmt(Math.round(capital)) + ' €');
		setText('rIntereses', fmt(Math.round(totalIntereses)) + ' €');
		setText('rTotal', fmt(Math.round(totalPagado)) + ' €');
		setText('rCuota1', fmt(Math.round(cuota)) + ' €');

		// Escenario variable / mixta
		if (tipoSelect === 'variable' || tipoSelect === 'mixta') {
			setDisplay('variableSection', '');
			const tipoVar = EURIBOR + diferencial;
			const cuotaVar = cuotaMensual(capital, tipoVar, n);
			setText('rEuribor', EURIBOR.toFixed(2) + ' %');
			setText('rTipoVar', tipoVar.toFixed(2) + ' %');
			setText('rCuotaVar', fmt(Math.round(cuotaVar)) + ' €/mes');
		} else {
			setDisplay('variableSection', 'none');
		}

		// Tabla de amortización: primeros 12 meses
		const tbody = document.getElementById('amortBody');
		if (!tbody) return;
		tbody.innerHTML = '';
		const i = tipoAnual / 100 / 12;
		let saldo = capital;
		let totalCap = 0;
		let totalInt = 0;

		for (let m = 1; m <= 12 && saldo > 0; m++) {
			const intereses = saldo * i;
			const amortCapital = cuota - intereses;
			saldo = Math.max(saldo - amortCapital, 0);
			totalCap += amortCapital;
			totalInt += intereses;

			const tr = document.createElement('tr');
			tr.className = 'border-b border-stone-100';
			tr.innerHTML =
				'<td class="py-2 pr-3 font-mono">' + m + '</td>' +
				'<td class="py-2 pr-3 font-mono">' + fmt(Math.round(cuota)) + ' €</td>' +
				'<td class="py-2 pr-3 font-mono text-teal-700">' + fmt(Math.round(amortCapital)) + ' €</td>' +
				'<td class="py-2 pr-3 font-mono text-amber-600">' + fmt(Math.round(intereses)) + ' €</td>' +
				'<td class="py-2 font-mono">' + fmt(Math.round(saldo)) + ' €</td>';
			tbody.appendChild(tr);
		}

		const tfoot = document.createElement('tr');
		tfoot.className = 'font-semibold border-t border-stone-200';
		tfoot.innerHTML =
			'<td class="py-2 pr-3">Total</td>' +
			'<td class="py-2 pr-3 font-mono">' + fmt(Math.round(cuota * 12)) + ' €</td>' +
			'<td class="py-2 pr-3 font-mono text-teal-700">' + fmt(Math.round(totalCap)) + ' €</td>' +
			'<td class="py-2 pr-3 font-mono text-amber-600">' + fmt(Math.round(totalInt)) + ' €</td>' +
			'<td class="py-2"></td>';
		tbody.appendChild(tfoot);
	}

	declare global {
		interface Window {
			calcular: () => void;
			actualizarHint: () => void;
		}
	}

	window.calcular = calcular;
	window.actualizarHint = actualizarHint;
</script>
