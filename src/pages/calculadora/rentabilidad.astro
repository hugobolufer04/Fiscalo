---
import Layout from '../../layouts/Layout.astro';
import Header from '../../sections/Header.astro';
import Footer from '../../sections/Footer.astro';
---

<Layout>
	<Header />

	<main class="pt-28 pb-20 max-w-[1200px] mx-auto px-6">
		<div class="text-center mb-12">
			<div class="font-mono text-xs uppercase tracking-widest text-teal-700 mb-3">Calculadora de Rentabilidad</div>
			<h1 class="font-serif text-3xl md:text-5xl text-stone-900 mb-3">Haz crecer tu dinero</h1>
			<p class="text-lg text-stone-500 max-w-[560px] mx-auto">Calcula el rendimiento de tus inversiones: interés compuesto, rentabilidad anual y proyecciones a largo plazo.</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

			<!-- FORMULARIO -->
			<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm lg:sticky lg:top-24">

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
					<div>
						<label for="inicial" class="block text-sm font-semibold text-stone-900 mb-1.5">Inversión inicial (€)</label>
						<input type="number" id="inicial" min="0" step="100" placeholder="10.000" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700" />
					</div>
					<div>
						<label for="mensual" class="block text-sm font-semibold text-stone-900 mb-1.5">Aportación mensual (€)</label>
						<input type="number" id="mensual" min="0" step="10" placeholder="200" value="0" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700" />
						<div class="text-xs text-stone-500 mt-1">Opcional, por ejemplo 200</div>
					</div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
					<div>
						<label for="rentabilidad" class="block text-sm font-semibold text-stone-900 mb-1.5">Rentabilidad anual (%)</label>
						<input type="number" id="rentabilidad" min="0" max="100" step="0.1" placeholder="7" value="7" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700" />
						<div class="text-xs text-stone-500 mt-1">Rentabilidad media esperada</div>
					</div>
					<div>
						<label for="anios" class="block text-sm font-semibold text-stone-900 mb-1.5">Años de inversión</label>
						<input type="number" id="anios" min="1" max="50" step="1" placeholder="20" value="20" class="w-full px-4 py-3 rounded-lg border border-stone-300 bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-teal-700" />
					</div>
				</div>

				<button onclick="calcular()" class="w-full px-8 py-3.5 rounded-lg text-sm font-semibold text-white bg-teal-700 hover:bg-teal-800 transition-colors cursor-pointer">
					Calcular rentabilidad
				</button>
			</div>

			<!-- RESULTADOS -->
			<div>
				<div id="placeholder" class="bg-white/70 backdrop-blur-md border border-dashed border-stone-300 rounded-2xl p-10 text-center text-stone-500">
					Introduce tu inversión y proyección, y pulsa <strong class="text-teal-700">Calcular</strong>.
				</div>

				<div id="resultados" style="display:none">
					<!-- Total -->
					<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm mb-5">
						<div class="text-sm text-stone-500 mb-1">Valor final estimado</div>
						<div class="font-mono text-5xl font-semibold text-teal-700" id="valorFinal">—</div>
						<div class="text-sm text-stone-500 mt-1" id="resumen"></div>

						<div class="mt-6 space-y-3">
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Inversión inicial</span>
								<span class="font-mono font-medium" id="rInicial">—</span>
							</div>
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Aportaciones totales</span>
								<span class="font-mono font-medium" id="rAportaciones">—</span>
							</div>
							<div class="flex justify-between text-sm">
								<span class="text-stone-500">Total aportado</span>
								<span class="font-mono font-medium" id="rTotalAportado">—</span>
							</div>
							<div class="flex justify-between text-sm border-t border-stone-200 pt-3">
								<span class="text-stone-900 font-semibold">Rendimiento / intereses</span>
								<span class="font-mono font-semibold text-teal-700" id="rRendimiento">—</span>
							</div>
						</div>
					</div>

					<!-- Proyección -->
					<div class="bg-white/70 backdrop-blur-md border border-stone-200 rounded-2xl p-8 shadow-sm">
						<h3 class="font-serif text-xl font-medium text-stone-900 mb-4">Proyección año a año</h3>
						<div class="overflow-x-auto">
							<table class="w-full text-sm">
								<thead>
									<tr class="text-left text-xs uppercase tracking-wider text-stone-500 border-b border-stone-200">
										<th class="py-2 pr-3">Año</th>
										<th class="py-2 pr-3 text-right">Aportado</th>
										<th class="py-2 text-right text-teal-700">Valor final</th>
									</tr>
								</thead>
								<tbody id="proyBody"></tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

		</div>
	</main>

	<Footer />
</Layout>

<script>
	const fmt = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 0 }) + ' €';

	const getInput = (id: string): HTMLInputElement | null =>
		document.getElementById(id) as HTMLInputElement | null;

	function setText(id: string, value: string): void {
		const el = document.getElementById(id);
		if (el) el.textContent = value;
	}

	function setDisplay(id: string, value: string): void {
		const el = document.getElementById(id);
		if (el) el.style.display = value;
	}

	function calcular(): void {
		const inicialEl = getInput('inicial');
		const mensualEl = getInput('mensual');
		const rentabilidadEl = getInput('rentabilidad');
		const aniosEl = getInput('anios');
		if (!inicialEl || !mensualEl || !rentabilidadEl || !aniosEl) return;

		const inicial = parseFloat(inicialEl.value);
		if (isNaN(inicial) || inicial < 0) return;

		const mensual = parseFloat(mensualEl.value) || 0;
		const rentabilidad = parseFloat(rentabilidadEl.value) || 0;
		const anios = parseInt(aniosEl.value, 10);

		// Interés compuesto con aportación mensual
		const rMensual = rentabilidad / 100 / 12;
		const nMeses = anios * 12;

		let valor = inicial;
		let aportado = inicial;
		const filas: { anio: number; aportado: number; valor: number }[] = [];

		for (let m = 1; m <= nMeses; m++) {
			valor = valor * (1 + rMensual) + mensual;
			aportado += mensual;
			if (m % 12 === 0) {
				filas.push({ anio: m / 12, aportado, valor });
			}
		}

		const totalAportado = inicial + mensual * nMeses;
		const rendimiento = valor - totalAportado;

		setDisplay('placeholder', 'none');
		setDisplay('resultados', '');

		setText('valorFinal', fmt(valor));
		setText('resumen', 'Tras ' + anios + ' años al ' + rentabilidad.toFixed(1) + ' % anual' + (mensual > 0 ? ' con ' + fmt(mensual) + '/mes' : ''));
		setText('rInicial', fmt(inicial));
		setText('rAportaciones', fmt(mensual * nMeses) + (mensual > 0 ? ' (' + fmt(mensual) + '/mes)' : ''));
		setText('rTotalAportado', fmt(totalAportado));
		setText('rRendimiento', fmt(rendimiento) + ' (' + (totalAportado > 0 ? ((rendimiento / totalAportado) * 100).toFixed(1) + ' %' : '0 %') + ')');

		// Proyección
		const tbody = document.getElementById('proyBody');
		if (!tbody) return;
		tbody.innerHTML = '';
		for (let i = 0; i < filas.length; i++) {
			const f = filas[i];
			const tr = document.createElement('tr');
			tr.className = 'border-b border-stone-100 last:border-0';
			tr.innerHTML =
				'<td class="py-2 pr-3">Año ' + f.anio + '</td>' +
				'<td class="py-2 pr-3 font-mono text-right">' + fmt(f.aportado) + '</td>' +
				'<td class="py-2 font-mono text-right text-teal-700">' + fmt(f.valor) + '</td>';
			tbody.appendChild(tr);
		}
	}

	declare global {
		interface Window {
			calcular: () => void;
		}
	}

	window.calcular = calcular;
</script>
