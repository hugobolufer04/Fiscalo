<script>
  const navbar = document.getElementById('navbar');

  function handleScroll() {
    if (window.scrollY > 40) {
      navbar?.classList.add('bg-[#f7f4ef]/80', 'backdrop-blur-md', 'shadow-sm');
    } else {
      navbar?.classList.remove('bg-[#f7f4ef]/80', 'backdrop-blur-md', 'shadow-sm');
    }
  }

  window.addEventListener('scroll', handleScroll);
</script>